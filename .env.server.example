# ===========================================================================
# Exavyn — SERVER-ONLY secrets (example — placeholders only)
# ===========================================================================
# Copy this file to `.env.server.local` (gitignored) and fill in real values in
# your editor. NEVER commit real values.
#
# Rules:
#   * NEVER prefix these with VITE_ (VITE_* is bundled into the browser).
#   * NEVER import this file from frontend code (anything under src/).
#   * This file is read only by server-side tools:
#       - supabase/tests/*.mjs        (hosted RLS / workflow / concurrency)
#       - scripts/seed-demo.mjs       (fixture seeding)
#       - playwright.config.ts        (authenticated browser tests)
#
# Browser-safe Supabase config stays in `.env.local`
# (VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_APP_NAME).
#
# Check which values are present (never prints values):  npm run check:env
# ---------------------------------------------------------------------------

# --- Supabase project connection -------------------------------------------------
# Optional here — the suites fall back to VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
# from .env.local. Set these only to target a project other than the one the
# frontend uses.
# Where: Supabase dashboard -> Project Settings -> API (Project URL, anon/publishable key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-publishable-key

# Required by the workflow/concurrency suites and scripts/seed-demo.mjs.
# Where: Project Settings -> API -> Project API keys -> service_role (Reveal).
# Treat as a full-access secret; used only in Node, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Password applied to seeded demo accounts (default: ExamDemo!234).
# Also used by supabase/tests/rls.test.mjs to sign in as the demo users.
SEED_PASSWORD=

# --- Supabase CLI (npx supabase) --------------------------------------------------
# Required for migration history, function deploy, and `secrets set`.
# Where: https://supabase.com/dashboard/account/tokens -> "Generate new token".
SUPABASE_ACCESS_TOKEN=

# Optional. Required only for commands that open a direct DB connection
# (`db push`, `db pull`, `db diff`, `db dump`), not for `migration list`.
# Where: Project Settings -> Database -> Connection string / Database password.
SUPABASE_DB_PASSWORD=

# --- One-time administrator bootstrap --------------------------------------------
# Required to invoke the bootstrap-admin Edge Function exactly once. Rotate or
# remove it (dashboard -> Edge Functions -> Secrets) after admin setup is confirmed.
# Set as an Edge Function secret: npx supabase secrets set BOOTSTRAP_ADMIN_TOKEN=...
# Where: you generate this yourself (e.g. `openssl rand -hex 32`).
BOOTSTRAP_ADMIN_TOKEN=

# --- Authenticated browser (Playwright) tests ------------------------------------
# Set E2E_SUPABASE_CONFIGURED=true plus a student that is approved on a course
# with a published exam. Leave unset to skip these tests.
E2E_SUPABASE_CONFIGURED=false
E2E_BASE_URL=http://localhost:5177
E2E_STUDENT_EMAIL=student-e2e@exam.test
E2E_STUDENT_PASSWORD=
E2E_EXAM_ID=
