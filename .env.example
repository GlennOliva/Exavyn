# ---------------------------------------------------------------------------
# Exavyn — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (or `.env`) and fill in real values.
# NEVER commit real values. NEVER put service-role keys in VITE_* variables.
#
# The frontend only ever receives the *publishable* (anon) Supabase values
# below. They are safe to ship to the browser because Row Level Security
# protects every table. Service-role keys and secrets are used exclusively by
# Supabase Edge Functions and must be provided as Edge Function secrets, not
# as VITE_* variables.
# ---------------------------------------------------------------------------

# Browser-safe Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://tddmtdhhckykwnoydvjc.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_advmhlM7mMJRa2x7a_j5rw_jLjGKO5i

# Optional: base path the app is served from (leave empty for root)
VITE_APP_NAME=Exavyn

# Optional site origin for non-recovery uses. Password recovery is hardcoded to
# https://exavyn.vercel.app/update-password and ignores this value.
# VITE_PUBLIC_SITE_URL=https://exavyn.vercel.app

# ---------------------------------------------------------------------------
# Server-only secrets live in a SEPARATE file: `.env.server.local`
# (see the committed template `.env.server.example`).
#
# That file is used only by server-side tools — the Node verification suites
# (supabase/tests/*.mjs), scripts/seed-demo.mjs, and playwright.config.ts — and
# is provided to Edge Functions via `supabase secrets set KEY=value`. These
# variables are intentionally NOT prefixed with VITE_ and must never appear in
# frontend bundles or be imported by anything under src/.
#
# Check which server variables are present (never prints values):
#   npm run check:env
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# End-to-end (Playwright) test configuration — optional
# The authenticated exam spec skips unless E2E_SUPABASE_CONFIGURED=true and
# student credentials are supplied.
# ---------------------------------------------------------------------------
# E2E_BASE_URL=http://localhost:5177
# E2E_SUPABASE_CONFIGURED=true
# E2E_STUDENT_EMAIL=student-e2e@exam.test
# E2E_STUDENT_PASSWORD=...
# E2E_EXAM_ID=<published exam uuid>
# E2E_TEACHER_EMAIL=teacher-e2e@exam.test
# E2E_TEACHER_PASSWORD=...
# E2E_COURSE_ID=<course uuid>
