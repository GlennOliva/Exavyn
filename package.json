{
  "name": "exam_detector",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "test:workflow": "node supabase/tests/workflow.test.mjs",
    "test:concurrency": "node supabase/tests/concurrency.test.mjs",
    "test:finality": "node supabase/tests/finality.test.mjs",
    "test:hosted": "npm run test:rls && npm run test:workflow && npm run test:concurrency && npm run test:finality",
    "test:e2e": "playwright test",
    "check:project": "node scripts/check-project.mjs",
    "check:env": "node scripts/check-env.mjs",
    "admin:provision": "node scripts/provision-admin.mjs",
    "admin:verify": "node scripts/verify-admin-login.mjs",
    "user:provision": "node scripts/provision-user.mjs",
    "seed": "node scripts/seed-demo.mjs",
    "e2e:fixture": "node scripts/prepare-e2e-departure.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^5.0.4"
  }
}
